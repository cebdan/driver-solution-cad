## Часть 8: СОБЫТИЯ - Жизненный Цикл Окна

### Все Важные События
```cpp
#include <xtd/xtd>

using namespace xtd::forms;

int main() {
  auto window = form::create("События Окна");
  window.size({400, 300});
  
  // 1. LOAD - окно создано, но ещё не показано
  window.load += [](object& sender, const event_args& e) {
    message_box::show("Событие LOAD: окно загружено");
  };
  
  // 2. SHOWN - окно показано первый раз
  window.shown += [](object& sender, const event_args& e) {
    message_box::show("Событие SHOWN: окно показано");
  };
  
  // 3. ACTIVATED - окно получило фокус
  window.activated += [](object& sender, const event_args& e) {
    // Не показываем message_box, он замучает
    // message_box::show("Окно активно");
  };
  
  // 4. DEACTIVATE - окно потеряло фокус
  window.deactivate += [](object& sender, const event_args& e) {
    // message_box::show("Окно неактивно");
  };
  
  // 5. FORM_CLOSING - окно закрывается (МОЖНО ОТМЕНИТЬ!)
  window.form_closing += [](object& sender, form_closing_event_args& e) {
    auto result = message_box::show(
      "Точно закрыть?",
      "Подтверждение",
      message_box_buttons::yes_no
    );
    
    if (result == dialog_result::no) {
      e.cancel(true);  // Отменяем закрытие
    }
  };
  
  // 6. FORM_CLOSED - окно закрыто (ОТМЕНИТЬ НЕЛЬЗЯ!)
  window.form_closed += [](object& sender, const event_args& e) {
    // Здесь делаем финальную очистку
    // message_box НЕ показывай - окно уже закрыто
  };
  
  application::run(window);
}
```

### Порядок Событий
```
Программа запускается
        ↓
window.load         ← Окно загружено
        ↓
window.shown        ← Окно показано
        ↓
window.activated    ← Окно активно
        ↓
   (работаем)
        ↓
Пользователь нажал X
        ↓
window.form_closing ← Можем отменить: e.cancel(true)
        ↓
   Закрываем?
   YES ↓       NO → возврат к работе
window.form_closed  ← Уже закрыто
        ↓
    Программа завершается
```

