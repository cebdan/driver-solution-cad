## Часть 9: РАБОТА С НЕСКОЛЬКИМИ ОКНАМИ

### Пример 18: Владелец Окна (Owner)
```cpp
#include <xtd/xtd>

using namespace xtd::forms;

int main() {
  auto main_window = form::create("Главное Окно");
  main_window.size({400, 300});
  
  auto button = button::create(main_window, "Открыть дочернее", {10, 10});
  
  button.click += [&] {
    auto child_window = form::create("Дочернее Окно");
    child_window.size({300, 200});
    
    // ВАЖНО: устанавливаем владельца
    child_window.owner(main_window);
    
    // Теперь:
    // - child_window всегда поверх main_window
    // - если минимизируешь main_window, child_window тоже минимизируется
    // - если закроешь main_window, child_window тоже закроется
    
    child_window.show();
  };
  
  application::run(main_window);
}
```

### Пример 19: Управление Группой Окон
```cpp
#include <xtd/xtd>
#include <vector>

using namespace xtd::forms;

class multi_window_app {
private:
  form main_window;
  std::vector<form> child_windows;
  
public:
  multi_window_app() {
    main_window = form::create("Менеджер Окон");
    main_window.size({400, 300});
    
    auto create_btn = button::create(main_window, "Создать окно", {10, 10});
    auto show_all_btn = button::create(main_window, "Показать все", {10, 50});
    auto hide_all_btn = button::create(main_window, "Спрятать все", {10, 90});
    auto close_all_btn = button::create(main_window, "Закрыть все", {10, 130});
    
    create_btn.click += [this] {
      auto child = form::create("Окно " + std::to_string(child_windows.size() + 1));
      child.size({300, 200});
      child.owner(main_window);
      child_windows.push_back(child);
      child.show();
    };
    
    show_all_btn.click += [this] {
      for (auto& child : child_windows) {
        child.show();
      }
    };
    
    hide_all_btn.click += [this] {
      for (auto& child : child_windows) {
        child.hide();
      }
    };
    
    close_all_btn.click += [this] {
      for (auto& child : child_windows) {
        child.close();
      }
      child_windows.clear();
    };
  }
  
  void run() {
    application::run(main_window);
  }
};

int main() {
  multi_window_app app;
  app.run();
}
```

