## Часть 6: ПРАКТИЧЕСКИЕ ПРИМЕРЫ

### Пример 13: Окно с Системным Треем
```cpp
#include <xtd/xtd>

using namespace xtd::forms;
using namespace xtd::drawing;

int main() {
  auto main_window = form::create("Приложение");
  main_window.size({400, 300});
  
  // Создаём иконку в трее
  auto tray = notify_icon();
  tray.text("Моё Приложение");
  tray.icon(system_icons::application());
  tray.visible(true);
  
  // Двойной клик по трею - показать окно
  tray.double_click += [&] {
    main_window.show();
    main_window.window_state(form_window_state::normal);
  };
  
  // При закрытии - НЕ закрываем, а прячем в трей
  main_window.form_closing += [&](object& sender, form_closing_event_args& e) {
    e.cancel(true);  // Отменяем закрытие
    main_window.hide();  // Прячем окно
    
    // Показываем уведомление
    tray.show_balloon_tip(
      "Приложение свёрнуто",
      "Я в системном трее",
      notify_icon::balloon_tip_icon::info
    );
  };
  
  // Контекстное меню в трее
  auto tray_menu = context_menu();
  auto show_item = menu_item();
  show_item.text("Показать");
  show_item.click += [&] {
    main_window.show();
    main_window.window_state(form_window_state::normal);
  };
  
  auto exit_item = menu_item();
  exit_item.text("Выход");
  exit_item.click += [&] {
    tray.visible(false);
    application::exit();  // Настоящий выход
  };
  
  tray_menu.menu_items().push_back(show_item);
  tray_menu.menu_items().push_back(exit_item);
  tray.context_menu(tray_menu);
  
  application::run(main_window);
}
```

### Пример 14: Мастер с Несколькими Шагами
```cpp
#include <xtd/xtd>

using namespace xtd;
using namespace xtd::forms;

int main() {
  auto wizard = form::create("Мастер Установки");
  wizard.size({500, 400});
  wizard.form_border_style(forms::form_border_style::fixed_dialog);
  wizard.maximize_box(false);
  wizard.minimize_box(false);
  
  // Три панели для шагов
  auto step1_panel = panel::create(wizard, {0, 0, 500, 350});
  auto step2_panel = panel::create(wizard, {0, 0, 500, 350});
  auto step3_panel = panel::create(wizard, {0, 0, 500, 350});
  
  // Контент шага 1
  label::create(step1_panel, "Шаг 1: Приветствие", {50, 50, 400, 30});
  
  // Контент шага 2
  label::create(step2_panel, "Шаг 2: Настройки", {50, 50, 400, 30});
  
  // Контент шага 3
  label::create(step3_panel, "Шаг 3: Завершение", {50, 50, 400, 30});
  
  // Изначально показываем только шаг 1
  step1_panel.visible(true);
  step2_panel.visible(false);
  step3_panel.visible(false);
  
  // Кнопки навигации
  auto back_btn = button::create(wizard, "< Назад", {150, 360, 100, 30});
  auto next_btn = button::create(wizard, "Далее >", {260, 360, 100, 30});
  
  back_btn.enabled(false);  // На первом шаге нельзя назад
  
  int current_step = 1;
  
  next_btn.click += [&] {
    if (current_step == 1) {
      // Переход 1 → 2
      step1_panel.visible(false);
      step2_panel.visible(true);
      current_step = 2;
      back_btn.enabled(true);
      
    } else if (current_step == 2) {
      // Переход 2 → 3
      step2_panel.visible(false);
      step3_panel.visible(true);
      current_step = 3;
      next_btn.text("Готово");
      
    } else if (current_step == 3) {
      // Закрываем мастер
      wizard.close();
    }
  };
  
  back_btn.click += [&] {
    if (current_step == 2) {
      // Переход 2 → 1
      step2_panel.visible(false);
      step1_panel.visible(true);
      current_step = 1;
      back_btn.enabled(false);
      
    } else if (current_step == 3) {
      // Переход 3 → 2
      step3_panel.visible(false);
      step2_panel.visible(true);
      current_step = 2;
      next_btn.text("Далее >");
    }
  };
  
  application::run(wizard);
}
```

### Пример 15: Splash Screen при Загрузке
```cpp
#include <xtd/xtd>
#include <thread>

using namespace xtd;
using namespace xtd::forms;
using namespace xtd::drawing;

int main() {
  // Создаём splash screen
  auto splash = form::create();
  splash.text("");
  splash.size({400, 200});
  splash.start_position(form_start_position::center_screen);
  splash.form_border_style(forms::form_border_style::none);
  splash.back_color(color::dark_blue);
  
  auto splash_label = label::create(splash, "Загрузка приложения...", {0, 80, 400, 40});
  splash_label.fore_color(color::white);
  splash_label.font(drawing::font("Arial", 16, font_style::bold));
  splash_label.text_align(content_alignment::middle_center);
  
  // Показываем splash БЕЗ блокировки
  splash.show();
  
  // Обрабатываем события (чтобы splash отрисовался)
  application::do_events();
  
  // Имитируем загрузку
  std::this_thread::sleep_for(std::chrono::seconds(3));
  
  // Закрываем splash
  splash.close();
  
  // Показываем главное окно
  auto main_window = form::create("Главное Окно");
  main_window.size({600, 400});
  
  application::run(main_window);
}
```

