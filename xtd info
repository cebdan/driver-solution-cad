  auto window = form::create();
  window.size({400, 300});
  window.start_position(form_start_position::center_screen);
  
  // Убираем всю стандартную рамку
  window.form_border_style(form_border_style::none);
  window.back_color(color::dark_gray);
  
  // Создаём свой заголовок
  auto title_bar = panel::create(window, {0, 0, 400, 40});
  title_bar.back_color(color::black);
  
  auto title_label = label::create(title_bar, "Кастомное Окно", {10, 10, 300, 20});
  title_label.fore_color(color::white);
  
  // Своя кнопка закрытия
  auto close_btn = button::create(title_bar, "X", {360, 5, 30, 30});
  close_btn.back_color(color::red);
  close_btn.fore_color(color::white);
  close_btn.click += [&] {
    window.close();
  };
  
  // ВАЖНО: делаем окно перетаскиваемым
  bool dragging = false;
  point drag_start;
  
  title_bar.mouse_down += [&](object& sender, const mouse_event_args& e) {
    dragging = true;
    drag_start = e.location();
  };
  
  title_bar.mouse_move += [&](object& sender, const mouse_event_args& e) {
    if (dragging) {
      point current_screen_pos = title_bar.point_to_screen(e.location());
      window.location(point(
        current_screen_pos.x() - drag_start.x(),
        current_screen_pos.y() - drag_start.y()
      ));
    }
  };
  
  title_bar.mouse_up += [&](object& sender, const mouse_event_args& e) {
    dragging = false;
  };
  
  application::run(window);
}
```

