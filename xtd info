## Часть 5: ENABLED - Включить/Выключить

### Пример 12: Блокируем Окно
```cpp
#include <xtd/xtd>

using namespace xtd::forms;

int main() {
  auto main_window = form::create("Главное");
  main_window.size({400, 300});
  
  auto lock_btn = button::create(main_window, "Заблокировать окно", {10, 10});
  auto unlock_btn = button::create(main_window, "Разблокировать окно", {10, 50});
  
  lock_btn.click += [&] {
    // Блокируем окно (нельзя кликать, но видно)
    main_window.enabled(false);
    
    // ПРОБЛЕМА: кнопки тоже заблокированы!
    // Нужно разблокировать снаружи или таймером
    
    auto timer = forms::timer();
    timer.interval(std::chrono::seconds(3));
    timer.tick += [&] {
      main_window.enabled(true);
      timer.enabled(false);
    };
    timer.enabled(true);
  };
  
  unlock_btn.click += [&] {
    main_window.enabled(true);
  };
  
  application::run(main_window);
}
```

**enabled vs visible:**
```cpp
form.visible(false);  // Окно НЕВИДИМО
form.enabled(false);  // Окно ВИДИМО, но заблокировано (серое)
```

