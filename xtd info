## Часть 7: ВАЖНЫЕ СВОЙСТВА ОКОН

### Пример 16: Настройка Границ и Кнопок
```cpp
#include <xtd/xtd>

using namespace xtd::forms;

int main() {
  auto window = form::create("Настройка Окна");
  window.size({400, 300});
  
  // ГРАНИЦА ОКНА
  // none - без рамки
  // fixed_single - фиксированный размер, тонкая рамка
  // fixed_3d - фиксированный размер, 3D рамка
  // fixed_dialog - как диалог
  // sizable - можно изменять размер (по умолчанию)
  // fixed_tool_window - маленькая панель инструментов
  // sizable_tool_window - панель инструментов с изменяемым размером
  
  window.form_border_style(form_border_style::fixed_dialog);
  
  // КНОПКИ В ЗАГОЛОВКЕ
  window.minimize_box(true);   // Кнопка свернуть
  window.maximize_box(false);  // Без кнопки развернуть
  window.control_box(true);    // Кнопка закрыть и иконка
  
  // ПОВЕДЕНИЕ
  window.top_most(false);      // Поверх всех окон (false = нет)
  window.show_in_taskbar(true); // Показывать в таскбаре
  
  // ПРОЗРАЧНОСТЬ (0.0 = невидимо, 1.0 = непрозрачно)
  window.opacity(1.0);
  
  application::run(window);
}
```

